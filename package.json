{
  "name": "cfvdex",
  "version": "0.1.0",
  "description": "CFVDEX decentralized peer-to-peer exchange scaffold",
  "main": "dist-electron/main.js",
  "author": "12 Digital Gold Foundation",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron -r ts-node/register/transpile-only electron/main.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@libp2p/bootstrap": "^12.0.18",
    "@libp2p/kad-dht": "^16.2.2",
    "@libp2p/mdns": "^12.0.18",
    "@libp2p/noise": "^1.0.1",
    "@libp2p/tcp": "^11.0.17",
    "@libp2p/websockets": "^10.1.10",
    "@libp2p/yamux": "^8.0.1",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.3.9",
    "libp2p": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "yjs": "^13.6.24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.31.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.18",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "org.digitalgoldfoundation.cfvdex",
    "productName": "CFVDEX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance"
    },
    "publish": null
  }
}
