{
  "name": "cfvdex",
  "version": "0.2.0",
  "description": "CFVDEX decentralized peer-to-peer exchange — web application",
  "main": "dist-server/server/index.js",
  "author": "12 Digital Gold Foundation",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:full": "npx concurrently -k \"npm:dev\" \"npm:dev:server\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@libp2p/bootstrap": "^12.0.18",
    "@libp2p/kad-dht": "^16.2.2",
    "@libp2p/mdns": "^12.0.18",
    "@libp2p/noise": "^1.0.1",
    "@libp2p/tcp": "^11.0.17",
    "@libp2p/websockets": "^10.1.10",
    "@libp2p/yamux": "^8.0.1",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "libp2p": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "uuid": "^14.0.0",
    "ws": "^8.20.0",
    "yjs": "^13.6.24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^5.4.18",
    "vitest": "^4.1.4"
  }
}
